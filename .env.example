# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
API_KEY_ENCRYPTION_SECRET=change-me

# Local PostgreSQL
POSTGRES_DB=jpfx
TEST_POSTGRES_DB=jpfx_test
POSTGRES_USER=jpfx
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://jpfx:change-me@localhost:5432/jpfx
TEST_DATABASE_URL=postgresql+psycopg://jpfx:change-me@localhost:5433/jpfx_test

# Supabase deployment
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# External providers
BOCHA_API_KEY=
DASHSCOPE_API_KEY=

# Local development
LOCAL_STORAGE_DIR=storage
